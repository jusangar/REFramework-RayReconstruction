# The shaders of the RayReconstruction Mod, embedded in dinput8.dll as byte arrays: the Mod compiles them
# at run time with D3DCompile, with Guides.hlsli next to them. Byte arrays, and not string literals, so
# that MSVC's limit on a literal (C2026) and the escapes do not apply. Included by cmake.toml at configure
# time, which runs again when a shader changes.
#
# Writes RrShaders.inc to RR_SHADERS_DIR, with one array per file, named after it: GuidePass.hlsl gives
# rr::shaders::GUIDEPASS_HLSL, null-terminated.
set(RR_SHADERS
    "${CMAKE_CURRENT_LIST_DIR}/core/Guides.hlsli"
    "${CMAKE_CURRENT_LIST_DIR}/GuidePass.hlsl"
)
set(RR_SHADERS_DIR "${CMAKE_CURRENT_BINARY_DIR}/rr_shaders")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${RR_SHADERS} "${CMAKE_CURRENT_LIST_FILE}")

set(RR_SHADERS_CONTENT "// Generated by src/mods/rr/EmbedShaders.cmake at configure time. Do not edit.\n#pragma once\n\nnamespace rr::shaders {\n")

foreach(shader ${RR_SHADERS})
    file(READ "${shader}" bytes HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${bytes}")
    get_filename_component(name "${shader}" NAME)
    string(MAKE_C_IDENTIFIER "${name}" name)
    string(TOUPPER "${name}" name)
    string(APPEND RR_SHADERS_CONTENT "inline constexpr char ${name}[] = {${bytes}0x00};\n")
endforeach()

string(APPEND RR_SHADERS_CONTENT "} // namespace rr::shaders\n")

# Only when it changes, so that a configure does not rebuild what includes it.
file(CONFIGURE OUTPUT "${RR_SHADERS_DIR}/RrShaders.inc" CONTENT "${RR_SHADERS_CONTENT}" @ONLY)
